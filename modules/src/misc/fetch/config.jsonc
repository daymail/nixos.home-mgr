{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "nixos",
        "padding": {
            "top": 2
        },
        "color": {
            "1": "#82B8A9",
            "2": "#90E0F3"
        }
    },

    "display": {
        "separator": " \u001b[2m󰨃 "
    },
    "modules": [
        {
            "type": "custom",
            "keyColor": "#8C9C9A", // Structural border color from your palette (c4)
            "format": "╭────────────────────────────────────────────────────────────╮"
        },
        {
            "type": "os",
            "key": " OS",
            "keyColor": "red"
        },
        {
            "type": "kernel",
            "key": "│ \u001b[91m├",
            "keyColor": "white"
        },
        {
            "type": "packages",
            "key": "│ \u001b[91m├",
            "keyColor": "white"
        },
        {
            "type": "shell",
            "key": "│ \u001b[91m└",
            "keyColor": "white"
        },

        {
            "type": "custom",
            "keyColor": "#8C9C9A",
            "format": "╰────────────────────────────────────────────────────────────╯"
        },

        {
            "type": "custom",
            "keyColor": "#8C9C9A",
            "format": "╭────────────────────────────────────────────────────────────╮"
        },

        {
            "type": "custom",
            "key": "\ue62a THEME",
            "format": "      PASTEL DARK", 
            "keyColor": "blue"
        },
        {
            "type": "wm",
            "key": "│ \u001b[94m├",
            "keyColor": "white"
        },
        {
            "type": "theme",
            "key": "│ \u001b[94m├󰧨",
            "keyColor": "white"
        },
        {
            "type": "font",
            "key": "│ \u001b[94m├",
            "keyColor": "white"
        },
        {
            "type": "icons",
            "key": "│ \u001b[94m├",
            "keyColor": "white"
        },
        {
            "type": "cursor",
            "key": "│ \u001b[94m├",
            "keyColor": "white"
        },
        {
            "type": "terminal",
            "key": "│ \u001b[94m├",
            "keyColor": "white"
        },

        {
            "type": "monitor",
            "key": "│ \u001b[94m└󰹑",
            "keyColor": "white"
        },

        {
            "type": "custom",
            "keyColor": "#8C9C9A",
            "format": "╰────────────────────────────────────────────────────────────╯"
        },

        {
            "type": "custom",
            "keyColor": "#8C9C9A",
            "format": "╭────────────────────────────────────────────────────────────╮"
        },
        {
            "type": "host",
            "key": "󰨇 PC",
            "keyColor": "cyan"
        },
        {
            "type": "cpu",
            "key": "│ \u001b[96m├",
            "keyColor": "white"
        },
        {
            "type": "gpu",
            "key": "│ \u001b[96m├ ",
            "keyColor": "white"
        },
        {
            "type": "memory",
            "key": "│ \u001b[96m├󰑭",
            "keyColor": "white"
        },
        {
            "type": "uptime",
            "key": "│ \u001b[96m└󰅐",
            "keyColor": "white"
        },
        {
            "type": "player",
            "key": " SND",
            "keyColor": "green"
        },
        {
            "type": "media",
            "key": "│ \u001b[92m└󰝚",
            "keyColor": "white"
        },
        {
            "type": "custom",
            "keyColor": "#8C9C9A",
            "format": "╰────────────────────────────────────────────────────────────╯"
        },

        {
            "type": "colors",
            "symbol": "star",
            "block": {
                "width": 5,
                "range": [0, 13]
            }
        }
    ]
}
